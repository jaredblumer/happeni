<div class="bg-indigo-500 text-white py-8 px-4 rounded-lg mb-6 text-center shadow-lg">
  <h1 class="text-4xl font-bold">Settings</h1>
</div>

<div class="bg-white p-6 rounded-lg shadow-lg max-w-lg mx-auto">
  <!-- Receive Daily Event Reminder Emails -->
  <h2 class="text-2xl font-semibold text-gray-800 mb-4">Notifications</h2>
  <%= form_with model: @user, url: settings_path, local: true, class: "space-y-4 " do |f| %>
    <div class="flex space-x-4">
      <%= f.label :subscribed_to_email, "Receive Daily Event Reminder Emails:", class: "text-gray-700 text-md font-medium" %>
      <%= f.check_box :subscribed_to_email, class: "w-6 h-6 text-indigo-500 bg-gray-100 border-gray-300 rounded focus:ring-indigo-500 dark:focus:ring-indigo-500 dark:ring-offset-gray-800 focus:ring-2" %>
    </div>
    <% if flash[:notice] %>
        <div id="notice_flash" class="mt-4 text-sm text-indigo-500">
          <%= flash[:notice] %>
        </div>
    <% end %>
    <div class="flex space-x-4 mt-4">
      <%= button_to 'Save Changes', settings_path, method: :post, class: "bg-indigo-500 text-white font-medium py-2 px-4 rounded-md hover:bg-indigo-600" %>
      <%= link_to 'Back to Dashboard', events_path, class: "bg-white text-indigo-500 border border-indigo-500 font-medium py-2 px-4 rounded-md hover:bg-indigo-500 hover:text-white" %>
    </div>
  <% end %>
</div>
